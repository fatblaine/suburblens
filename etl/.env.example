# Supabase connection string — use the Connection Pooler URL (pgbouncer), NOT the direct URL
# Found in: Supabase Dashboard → Settings → Database → Connection String → Transaction pooler
# Format: postgres://postgres.[project-ref]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# sslmode=verify-full checks the server against Supabase's root CA (etl/certs/supabase-ca.crt).
# sslrootcert is resolved from the current directory, so use an absolute path.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=[ABSOLUTE-PATH-TO]/etl/certs/supabase-ca.crt

# Contact address put in the Overpass API User-Agent (etl_amenities.py).
# Optional — the ETL runs without it, but Overpass operators ask for a contact
# so they can reach you instead of silently rate-limiting. ASCII only.
OSM_CONTACT=you@example.com
